        "jsCode": "const report = items.find(\n  item => item.json.Summary_Report === true\n);\n\nreturn [\n  {\n    json: {\n      \"Total Rows Imported\": report.json.Total_Rows_Imported,\n      \"Rows Removed (Empty/Invalid)\": report.json.Rows_Removed_Empty_Invalid,\n      \"Duplicate Rows Removed\": report.json.Duplicate_Rows_Removed,\n      \"Invalid Emails Removed\": report.json.Invalid_Emails_Removed,\n      \"Invalid Phones Removed\": report.json.Invalid_Phones_Removed,\n      \"Final Row Count\": report.json.Final_Row_Count\n    }\n  }\n];"
