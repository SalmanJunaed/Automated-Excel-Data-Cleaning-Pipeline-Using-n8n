    {
      "parameters": {
        "jsCode": "const seenEmails = new Set();\nconst seenPhones = new Set();\n\nconst cleanText = (value) => {\nif (value === null || value === undefined) return \"\";\n\nreturn String(value)\n.trim()\n.replace(/\\s+/g, \" \");\n};\n\nconst properCase = (text) => {\nreturn cleanText(text)\n.toLowerCase()\n.replace(/\\b\\w/g, c => c.toUpperCase());\n};\n\nconst output = [];\n\nlet totalRows = items.length;\nlet emptyRows = 0;\nlet invalidEmails = 0;\nlet invalidPhones = 0;\nlet duplicates = 0;\n\nfor (const item of items) {\n\nlet name = properCase(item.json[\"Full Name\"]);\n\nlet email = cleanText(\nitem.json[\"Email\"]\n).toLowerCase();\n\nlet phone = cleanText(\nitem.json[\"Phone\"]\n);\n\nif (phone && !phone.startsWith(\"0\")) {\nphone = \"0\" + phone;\n}\n\nlet city = properCase(\nitem.json[\"City\"]\n);\n\nconst dateRaw =\nitem.json[\"Registration Date\"];\n\n// Empty Row Check\nif (!name || !email || !phone) {\nemptyRows++;\ncontinue;\n}\n\nif (email === \"(missing)\") {\nemptyRows++;\ncontinue;\n}\n\n// Email Validation\nconst emailValid =\n/^[^\\s@]+@[^\\s@]+.[^\\s@]+$/.test(email);\n\nif (!emailValid) {\ninvalidEmails++;\ncontinue;\n}\n\n// Phone Validation\nconst phoneValid =\n/^01\\d{9}$/.test(phone);\n\nif (!phoneValid) {\ninvalidPhones++;\ncontinue;\n}\n\n// Duplicate Check\nif (\nseenEmails.has(email) ||\nseenPhones.has(phone)\n) {\nduplicates++;\ncontinue;\n}\n\nseenEmails.add(email);\nseenPhones.add(phone);\n\nlet formattedDate = \"\";\n\ntry {\nformattedDate = new Date(dateRaw)\n.toISOString()\n.split(\"T\")[0];\n} catch {\nformattedDate = \"\";\n}\n\noutput.push({\njson: {\n\"Customer ID\":\n`CUST-${String(output.length + 1).padStart(4, \"0\")}`,\n\"Full Name\": name,\n\"Email\": email,\n\"Phone\": phone,\n\"City\": city,\n\"Registration Date\": formattedDate\n}\n});\n}\n\n// Summary Row Add\n\noutput.push({\njson: {\nSummary_Report: true,\nTotal_Rows_Imported: totalRows,\nRows_Removed_Empty_Invalid:\nemptyRows + invalidEmails + invalidPhones,\nDuplicate_Rows_Removed: duplicates,\nInvalid_Emails_Removed: invalidEmails,\nInvalid_Phones_Removed: invalidPhones,\nFinal_Row_Count:\noutput.length \n}\n});\n\nreturn output;\n"
      },
